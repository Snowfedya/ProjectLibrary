{
  "dashboard": {
    "id": null,
    "title": "Library Management System Dashboard",
    "description": "Comprehensive monitoring dashboard for Library Management System",
    "tags": ["library", "spring-boot", "monitoring"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "System Overview",
        "type": "row",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
        "collapsed": false
      },
      {
        "id": 2,
        "title": "Application Status",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 1},
        "targets": [
          {
            "expr": "up{job=\"library-service\"}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "custom": {
              "displayMode": "basic",
              "orientation": "auto"
            },
            "mappings": [
              {"options": {"0": {"text": "DOWN"}}, "type": "value"},
              {"options": {"1": {"text": "UP"}}, "type": "value"}
            ],
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "green", "value": 1}
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "title": "Total Books",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 1},
        "targets": [
          {
            "expr": "library_books_total",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"color": "green", "value": null}
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "Total Users",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 1},
        "targets": [
          {
            "expr": "library_users_total",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"color": "blue", "value": null}
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "title": "Active Rentals",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 1},
        "targets": [
          {
            "expr": "library_rentals_active",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"color": "orange", "value": null}
              ]
            }
          }
        }
      },
      {
        "id": 6,
        "title": "HTTP Requests",
        "type": "row",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5},
        "collapsed": false
      },
      {
        "id": 7,
        "title": "Request Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
        "targets": [
          {
            "expr": "rate(http_server_requests_seconds_count{job=\"library-service\"}[5m])",
            "legendFormat": "{{method}} {{uri}}",
            "refId": "A"
          }
        ],
        "yAxes": [
          {
            "label": "Requests/sec",
            "min": 0
          }
        ]
      },
      {
        "id": 8,
        "title": "Response Time (95th percentile)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(http_server_requests_seconds_bucket{job=\"library-service\"}[5m]))",
            "legendFormat": "{{method}} {{uri}}",
            "refId": "A"
          }
        ],
        "yAxes": [
          {
            "label": "Seconds",
            "min": 0
          }
        ]
      },
      {
        "id": 9,
        "title": "HTTP Status Codes",
        "type": "piechart",
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 14},
        "targets": [
          {
            "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"library-service\"}[5m]))",
            "legendFormat": "{{status}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 10,
        "title": "Business Metrics",
        "type": "row",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 22},
        "collapsed": false
      },
      {
        "id": 11,
        "title": "User Registrations (Rate)",
        "type": "graph",
        "gridPos": {"h": 6, "w": 8, "x": 0, "y": 23},
        "targets": [
          {
            "expr": "rate(library_users_registrations_total[5m])",
            "legendFormat": "Registrations/sec",
            "refId": "A"
          }
        ]
      },
      {
        "id": 12,
        "title": "Book Operations (Rate)",
        "type": "graph",
        "gridPos": {"h": 6, "w": 8, "x": 8, "y": 23},
        "targets": [
          {
            "expr": "rate(library_books_borrowed_total[5m])",
            "legendFormat": "Borrows/sec",
            "refId": "A"
          },
          {
            "expr": "rate(library_books_returned_total[5m])",
            "legendFormat": "Returns/sec",
            "refId": "B"
          },
          {
            "expr": "rate(library_books_searches_total[5m])",
            "legendFormat": "Searches/sec",
            "refId": "C"
          }
        ]
      },
      {
        "id": 13,
        "title": "Authentication Errors",
        "type": "stat",
        "gridPos": {"h": 6, "w": 8, "x": 16, "y": 23},
        "targets": [
          {
            "expr": "rate(library_auth_errors_total[5m])",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "red", "value": 0.01}
              ]
            }
          }
        }
      },
      {
        "id": 14,
        "title": "JVM Metrics",
        "type": "row",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 29},
        "collapsed": false
      },
      {
        "id": 15,
        "title": "JVM Memory Usage",
        "type": "graph",
        "gridPos": {"h": 6, "w": 12, "x": 0, "y": 30},
        "targets": [
          {
            "expr": "jvm_memory_used_bytes{job=\"library-service\"}",
            "legendFormat": "{{area}} - {{id}}",
            "refId": "A"
          }
        ],
        "yAxes": [
          {
            "label": "Bytes",
            "min": 0
          }
        ]
      },
      {
        "id": 16,
        "title": "JVM Threads",
        "type": "graph",
        "gridPos": {"h": 6, "w": 12, "x": 12, "y": 30},
        "targets": [
          {
            "expr": "jvm_threads_live_threads{job=\"library-service\"}",
            "legendFormat": "Live Threads",
            "refId": "A"
          },
          {
            "expr": "jvm_threads_peak_threads{job=\"library-service\"}",
            "legendFormat": "Peak Threads",
            "refId": "B"
          }
        ]
      }
    ],
    "time": {
      "from": "now-30m",
      "to": "now"
    },
    "timepicker": {},
    "timezone": "",
    "version": 0
  }
}